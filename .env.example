# Market selection (for strategy mode)
MARKET_QUERY=bitcoin
MAX_MARKETS=20

# Signal (for strategy mode)
LOOKBACK_POINTS=5
MIN_SCORE=0.015
SPREAD_PENALTY=1.0

# Risk
BANKROLL_USDC=150
RISK_FRACTION=0.01
MAX_ORDER_USDC=25
MAX_DAILY_TRADES=10

# Runtime
LOOP_SECONDS=60
DRY_RUN=true

# Mode toggles
STRATEGY_ENABLED=false
COPY_TRADING_ENABLED=true

# Copy-trading source wallet
COPY_TRADER_ADDRESS=0x70ec235a31eb35f243e2618d6ea3b5b8962bbb5d
COPY_TRADE_LIMIT=20
COPY_SIZE_MULTIPLIER=1.0

# Live trading credentials (only used when DRY_RUN=false)
POLY_CHAIN_ID=137
POLY_PRIVATE_KEY=

# Optional: set for custodial/proxy account architectures
POLY_FUNDER_ADDRESS=
POLY_SIGNATURE_TYPE=

# Optional: if blank, bot attempts create_or_derive_api_creds()
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# Optional API overrides
GAMMA_BASE=https://gamma-api.polymarket.com
CLOB_BASE=https://clob.polymarket.com
DATA_BASE=https://data-api.polymarket.com
